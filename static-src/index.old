<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Exit Strategy · Dashboard</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #0a0e1a; color: #e0e6f0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; padding: 1rem; }
  .header { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; background: #0f1628; border: 0.5px solid #1e2d4a; border-radius: 10px; margin-bottom: 1rem; }
  .header-left { display: flex; align-items: center; gap: 12px; }
  .header-left img { height: 52px; }
  .header-title h1 { font-size: 15px; font-weight: 500; color: #e0e6f0; }
  .header-title p { font-size: 12px; color: #6b82a0; }
  .live { font-size: 12px; color: #4a9fd4; background: #0d1f38; padding: 4px 10px; border-radius: 6px; border: 0.5px solid #1e3a5a; display: flex; align-items: center; gap: 5px; }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: #3db87a; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
  .section { font-size: 11px; color: #6b82a0; text-transform: uppercase; letter-spacing: 0.06em; margin: 1rem 0 0.5rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-bottom: 10px; }
  .card { background: #0f1628; border: 0.5px solid #1e2d4a; border-radius: 10px; padding: 1rem; }
  .card-label { font-size: 11px; color: #6b82a0; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 6px; }
  .card-value { font-size: 30px; font-weight: 500; line-height: 1; }
  .card-unit { font-size: 14px; color: #6b82a0; margin-left: 2px; }
  .card-sub { font-size: 12px; color: #6b82a0; margin-top: 6px; }
  .bar-bg { height: 5px; background: #1e2d4a; border-radius: 3px; margin-top: 8px; overflow: hidden; }
  .bar-fill { height: 100%; border-radius: 3px; }
  .good { color: #3db87a; }
  .warn { color: #e8a030; }
  .info { color: #4a9fd4; }
  .purple { color: #a78bfa; }
  .status-row { display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border-bottom: 0.5px solid #1a2438; font-size: 13px; }
  .status-row:last-child { border-bottom: none; }
  .sdot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; margin-right: 8px; }
  .updated { font-size: 11px; color: #6b82a0; text-align: right; margin-top: 0.5rem; }
  .error { color: #e05050; font-size: 12px; }
</style>
</head>
<body>

<div class="header">
  <div class="header-left">
    <img src="/assets/logo.png" alt="Exit Strategy" style="height:52px;background:white;border-radius:6px;padding:4px 8px;">
    <div class="header-title">
      <h1>Exit Strategy</h1>
      <p>Bavaria 36 · Harborage Marina, St. Pete</p>
    </div>
  </div>
  <div class="live"><div class="dot"></div><span id="clock">--:--</span></div>
</div>

<div class="section">Environment · BME680</div>
<div class="grid">
  <div class="card">
    <div class="card-label">Temperature</div>
    <div class="card-value info" id="temp">--<span class="card-unit">°F</span></div>
    <div class="card-sub" id="temp-sub">Loading...</div>
    <div class="bar-bg"><div class="bar-fill info" id="temp-bar" style="width:0%;background:#4a9fd4"></div></div>
  </div>
  <div class="card">
    <div class="card-label">Humidity</div>
    <div class="card-value good" id="humidity">--<span class="card-unit">%</span></div>
    <div class="card-sub">Relative humidity</div>
    <div class="bar-bg"><div class="bar-fill" id="humidity-bar" style="width:0%;background:#3db87a"></div></div>
  </div>
  <div class="card">
    <div class="card-label">Pressure</div>
    <div class="card-value purple" id="pressure">--<span class="card-unit">hPa</span></div>
    <div class="card-sub" id="pressure-sub">Loading...</div>
  </div>
  <div class="card">
    <div class="card-label">Air quality (IAQ)</div>
    <div class="card-value" id="iaq">--</div>
    <div class="card-sub" id="iaq-label">Loading...</div>
    <div class="bar-bg"><div class="bar-fill" id="iaq-bar" style="width:0%"></div></div>
  </div>
</div>

<div class="section">Power system · Victron</div>
<div class="grid">
  <div class="card">
    <div class="card-label">House bank</div>
    <div class="card-value good" id="soc">--<span class="card-unit">%</span></div>
    <div class="card-sub" id="soc-sub">LiFePO4 200Ah</div>
    <div class="bar-bg"><div class="bar-fill good" id="soc-bar" style="width:0%;background:#3db87a"></div></div>
  </div>
  <div class="card">
    <div class="card-label">Voltage</div>
    <div class="card-value info" id="voltage">--<span class="card-unit">V</span></div>
    <div class="card-sub" id="voltage-sub">48V bank</div>
  </div>
  <div class="card">
    <div class="card-label">Current</div>
    <div class="card-value" id="current">--<span class="card-unit">A</span></div>
    <div class="card-sub" id="current-sub">--</div>
  </div>
  <div class="card">
    <div class="card-label">Power</div>
    <div class="card-value warn" id="power">--<span class="card-unit">W</span></div>
    <div class="card-sub" id="power-sub">--</div>
  </div>
</div>

<div class="section">System status</div>
<div class="card">
  <div class="status-row">
    <span><span class="sdot" style="background:#3db87a"></span>Cloudflare tunnel</span>
    <span class="good">Connected</span>
  </div>
  <div class="status-row">
    <span><span class="sdot" style="background:#3db87a"></span>MQTT broker</span>
    <span class="good">Running</span>
  </div>
  <div class="status-row">
    <span><span class="sdot" style="background:#3db87a"></span>MariaDB</span>
    <span class="good">Running</span>
  </div>
  <div class="status-row">
    <span><span class="sdot" id="influx-dot" style="background:#3db87a"></span>InfluxDB</span>
    <span class="good" id="influx-status">Connected</span>
  </div>
  <div class="status-row">
    <span><span class="sdot" style="background:#e8a030"></span>Victron VRM</span>
    <span class="warn">Pending auth</span>
  </div>
</div>
<div class="updated">Last updated: <span id="last-update">--</span></div>

<script>
function setText(id, val) {
  const el = document.getElementById(id);
  if (el) el.innerHTML = val;
}

function iaqLabel(val) {
  if (val < 50) return ['Excellent', '#3db87a'];
  if (val < 100) return ['Good', '#3db87a'];
  if (val < 150) return ['Moderate', '#e8a030'];
  if (val < 200) return ['Poor', '#e05050'];
  return ['Very poor', '#e05050'];
}

function clock() {
  document.getElementById('clock').textContent =
    new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
}
setInterval(clock, 1000);
clock();

async function fetchData() {
  try {
    const res = await fetch('/api/sensor');
    const d = await res.json();

    if (d.temp_f !== undefined) {
      setText('temp', `${d.temp_f.toFixed(1)}<span class="card-unit">°F</span>`);
      const pct = Math.min(100, Math.max(0, ((d.temp_f - 60) / 50) * 100));
      document.getElementById('temp-bar').style.width = pct + '%';
      setText('temp-sub', `${((d.temp_f - 32) * 5/9).toFixed(1)}°C`);
    }

    if (d.humidity !== undefined) {
      setText('humidity', `${d.humidity.toFixed(1)}<span class="card-unit">%</span>`);
      document.getElementById('humidity-bar').style.width = d.humidity + '%';
    }

    if (d.pressure !== undefined) {
      setText('pressure', `${d.pressure.toFixed(1)}<span class="card-unit">hPa</span>`);
      const trend = d.pressure > 1013 ? '↑ Rising · fair weather' : d.pressure < 1009 ? '↓ Falling · watch weather' : '→ Steady';
      const tcolor = d.pressure > 1013 ? 'good' : d.pressure < 1009 ? 'warn' : 'info';
      setText('pressure-sub', `<span class="${tcolor}">${trend}</span>`);
    }

    if (d.iaq !== undefined) {
      const [label, color] = iaqLabel(d.iaq);
      setText('iaq', `<span style="color:${color}">${d.iaq.toFixed(0)}</span>`);
      setText('iaq-label', `<span style="color:${color}">${label}</span>`);
      const pct = Math.min(100, (d.iaq / 300) * 100);
      const bar = document.getElementById('iaq-bar');
      bar.style.width = pct + '%';
      bar.style.background = color;
    }

    document.getElementById('last-update').textContent = new Date().toLocaleTimeString();
    document.getElementById('influx-dot').style.background = '#3db87a';
    document.getElementById('influx-status').textContent = 'Connected';
    document.getElementById('influx-status').className = 'good';

  } catch(e) {
    document.getElementById('influx-dot').style.background = '#e05050';
    document.getElementById('influx-status').textContent = 'Error';
    document.getElementById('influx-status').className = 'error';
    console.error(e);
  }
}

fetchData();
setInterval(fetchData, 60000);
</script>
</body>
</html>
